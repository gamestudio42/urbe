{
  "name": "city-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Isometric city builder inspired by classic city simulation games, running in the browser.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @city/web dev",
    "build": "pnpm --filter @city/web build",
    "preview": "pnpm --filter @city/web preview",
    "desktop:build": "BASE_PATH=./ pnpm --filter @city/web exec vite build --outDir ../desktop/www --emptyOutDir && pnpm --filter @city/desktop build",
    "desktop": "pnpm desktop:build && pnpm --filter @city/desktop start",
    "desktop:smoke": "pnpm desktop:build && tsx tools/desktop-smoke.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/shared && tsc -p packages/simulation && tsc -p apps/web && tsc -p apps/desktop && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:simulation": "vitest run --config vitest.scenarios.config.ts",
    "test:e2e": "playwright test",
    "sim": "tsx tools/headless-sim.ts",
    "bench": "tsx tools/benchmark.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:simulation && pnpm build"
  },
  "devDependencies": {
    "@city/shared": "workspace:*",
    "@city/simulation": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
